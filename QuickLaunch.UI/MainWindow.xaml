<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickLaunch.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickLaunch.UI"
    xmlns:vm="using:QuickLaunch.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        DesktopAcrylicBackdrop blurs whatever is behind the window.
        This is the right material for an overlay/launcher panel.
        Mica (the template default) samples the wallpaper — better for full app windows.
    -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!--
        RootPanel is what the entrance animation drives, so it is the window's single
        child: a composition translation here moves the whole panel. Its corner radius
        matches the radius Windows rounds the window to, so the tint stops exactly at the
        real edge. The visible border is DWM's, not a stroke drawn here — two 1px edges a
        pixel apart would read as one heavy, slightly wrong one.
    -->
    <Border x:Name="RootPanel"
            Background="{ThemeResource LauncherSurfaceBrush}"
            CornerRadius="{StaticResource LauncherCornerRadius}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==== Search row ==== -->
            <Grid Height="{StaticResource SearchRowHeight}"
                  Padding="{StaticResource LauncherContentPadding}">
                <!--
                    The leading column is Auto and its content carries the width token.
                    ColumnDefinition.Width is a GridLength, which a Double resource cannot
                    be assigned to, so the token lives on the element instead.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Segoe Fluent Icons search glyph (E721) -->
                <FontIcon Grid.Column="0"
                          Width="{StaticResource LeadingColumnWidth}"
                          Glyph="&#xE721;"
                          FontSize="{StaticResource SearchGlyphFontSize}"
                          Foreground="{ThemeResource GlyphBrush}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                <!--
                    Placeholder + TextBox layered in a Grid.
                    The placeholder is just a TextBlock behind the TextBox —
                    simpler and more controllable than TextBox.PlaceholderText,
                    which is hard to style in WinUI 3.
                -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <!-- x:Bind converts bool to Visibility implicitly, so no converter is needed. -->
                    <TextBlock x:Name="PlaceholderText"
                               Text="{x:Bind ViewModel.PlaceholderText, Mode=OneWay}"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="{StaticResource QueryFontSize}"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"
                               Visibility="{x:Bind ViewModel.IsQueryEmpty, Mode=OneWay}"/>

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource LauncherQueryBoxStyle}"
                             FontFamily="{StaticResource DisplayFontFamily}"
                             FontSize="{StaticResource QueryFontSize}"
                             Foreground="{ThemeResource TextPrimaryBrush}"
                             VerticalAlignment="Center"
                             Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown"/>
                </Grid>
            </Grid>

            <!-- ==== Results ==== -->
            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ShowsResultsArea, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hairline between query and results rather than a heavier divider. -->
                <Rectangle Fill="{ThemeResource LauncherSeparatorBrush}" Height="1"/>

                <!--
                    Nothing matched. Saying so is better than an empty panel, which reads
                    as the launcher having failed to respond.
                -->
                <Grid Grid.Row="1"
                      Height="{StaticResource ResultRowHeight}"
                      Padding="{StaticResource ResultsPadding}"
                      Visibility="{x:Bind ViewModel.ShowsEmptyState, Mode=OneWay}">
                    <TextBlock Text="No matching results"
                               Margin="{StaticResource EmptyStateTextMargin}"
                               FontFamily="{StaticResource TextFontFamily}"
                               FontSize="{StaticResource ResultTitleFontSize}"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!--
                    IsTabStop and AllowFocusOnInteraction are both off here and on the rows:
                    focus belongs to the query box at all times, and a click that moved it
                    into the list would leave the keyboard handling with nothing to fire on.
                -->
                <ScrollViewer x:Name="ResultsScroller"
                              Grid.Row="1"
                              Padding="{StaticResource ResultsPadding}"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Disabled"
                              IsTabStop="False"
                              AllowFocusOnInteraction="False"
                              Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                    <ItemsRepeater x:Name="ResultsRepeater"
                                   ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultItemViewModel">

                                <!--
                                    Background="Transparent" is load-bearing: a Grid with no
                                    brush is not hit-testable, so without it clicks fall
                                    straight through the row to the ScrollViewer behind it.
                                -->
                                <Grid Height="{StaticResource ResultRowHeight}"
                                      Background="Transparent"
                                      AllowFocusOnInteraction="False"
                                      Tapped="ResultRow_Tapped"
                                      PointerEntered="ResultRow_PointerEntered"
                                      PointerExited="ResultRow_PointerExited">

                                    <!--
                                        Selection and hover sit behind the content and span the
                                        whole row, so neither is inset by content padding.
                                        x:Bind converts the bools to Visibility implicitly.
                                    -->
                                    <Border Background="{ThemeResource RowHoverBrush}"
                                            CornerRadius="{StaticResource RowCornerRadius}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind ShowsHover, Mode=OneWay}"/>

                                    <Border Background="{ThemeResource RowSelectedBrush}"
                                            CornerRadius="{StaticResource RowCornerRadius}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay}"/>

                                    <!--
                                        The row's contents are decorative; all interaction
                                        belongs to the row itself. Pointer enter and exit
                                        bubble, so leaving the children hit-testable means a
                                        child's exit event clears the row's own hover state
                                        as the pointer crosses between them.
                                    -->
                                    <Grid Padding="{StaticResource RowPadding}" IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        Icon plate. Real shell icons replace the glyph in M2;
                                        the plate keeps the row rhythm identical either way.
                                    -->
                                    <Grid Grid.Column="0" Width="{StaticResource LeadingColumnWidth}">
                                        <Border Width="32" Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="{StaticResource IconPlateCornerRadius}"
                                                Background="{ThemeResource RowIconPlateBrush}">
                                            <Grid>
                                                <!--
                                                    The glyph holds the space until the real
                                                    icon arrives, so rows never reflow when
                                                    artwork lands a moment after the text.
                                                -->
                                                <FontIcon Glyph="{x:Bind Glyph}"
                                                          FontSize="{StaticResource ResultGlyphFontSize}"
                                                          Foreground="{ThemeResource GlyphBrush}"/>

                                                <Image Source="{x:Bind Icon, Mode=OneWay}"
                                                       Width="24" Height="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind HasIcon, Mode=OneWay}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontFamily="{StaticResource TextFontFamily}"
                                                   FontSize="{StaticResource ResultTitleFontSize}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   FontFamily="{StaticResource TextFontFamily}"
                                                   FontSize="{StaticResource ResultSubtitleFontSize}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   Visibility="{x:Bind HasSubtitle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind KindHint}"
                                               FontFamily="{StaticResource TextFontFamily}"
                                               FontSize="{StaticResource KindHintFontSize}"
                                               Foreground="{ThemeResource KindHintBrush}"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>

                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Border>
</Window>
