<!--
    Control styles for the launcher. Separate from Tokens.xaml, which holds only values.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The query box.

        The stock TextBox template brings a header, a placeholder presenter, a clear
        button, themed background and border brushes for six visual states, and a fixed
        internal padding. Every one of those had to be neutralised individually, and the
        clear button cannot be reached at all from outside the template. Replacing the
        template with the one part TextBox actually requires — a ScrollViewer named
        ContentElement — is both smaller and completely predictable.
    -->
    <Style x:Key="LauncherQueryBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="ContentElement"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled"
                                  ZoomMode="Disabled"
                                  IsTabStop="False"
                                  AutomationProperties.AccessibilityView="Raw"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
