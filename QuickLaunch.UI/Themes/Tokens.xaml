<!--
    The launcher's design vocabulary. Every visual value used anywhere in the app comes
    from here, so that light and dark stay in step and metrics stay on one grid.

    Colour roles are defined per theme in ThemeDictionaries; everything that is theme
    independent (spacing, radii, type ramp, motion) sits outside them.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <!-- Acrylic already supplies the ground, so surface tints stay nearly transparent. -->
            <SolidColorBrush x:Key="LauncherSurfaceBrush"      Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="LauncherBorderBrush"       Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="LauncherSeparatorBrush"    Color="#18FFFFFF"/>

            <SolidColorBrush x:Key="TextPrimaryBrush"          Color="#FAFAFA"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"        Color="#B4FAFAFA"/>
            <SolidColorBrush x:Key="TextTertiaryBrush"         Color="#78FAFAFA"/>

            <SolidColorBrush x:Key="GlyphBrush"                Color="#A0FAFAFA"/>

            <SolidColorBrush x:Key="RowHoverBrush"             Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="RowSelectedBrush"          Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="RowIconPlateBrush"         Color="#14FFFFFF"/>

            <SolidColorBrush x:Key="KindHintBrush"             Color="#66FAFAFA"/>
            <SolidColorBrush x:Key="TextSelectionBrush"        Color="#59FFFFFF"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LauncherSurfaceBrush"      Color="#0AFFFFFF"/>
            <SolidColorBrush x:Key="LauncherBorderBrush"       Color="#1A000000"/>
            <SolidColorBrush x:Key="LauncherSeparatorBrush"    Color="#14000000"/>

            <SolidColorBrush x:Key="TextPrimaryBrush"          Color="#151515"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"        Color="#A8151515"/>
            <SolidColorBrush x:Key="TextTertiaryBrush"         Color="#70151515"/>

            <SolidColorBrush x:Key="GlyphBrush"                Color="#99151515"/>

            <SolidColorBrush x:Key="RowHoverBrush"             Color="#0D000000"/>
            <SolidColorBrush x:Key="RowSelectedBrush"          Color="#1A000000"/>
            <SolidColorBrush x:Key="RowIconPlateBrush"         Color="#0F000000"/>

            <SolidColorBrush x:Key="KindHintBrush"             Color="#66151515"/>
            <SolidColorBrush x:Key="TextSelectionBrush"        Color="#40000000"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ==== Metrics =====================================================
         Everything sits on a 4px grid. The search row is 64 so the 32px icon
         plate in a result row can share the same optical centre line.
    -->
    <x:Double x:Key="LauncherWidth">680</x:Double>
    <x:Double x:Key="SearchRowHeight">64</x:Double>
    <x:Double x:Key="ResultRowHeight">52</x:Double>

    <!-- Width of the leading column. Glyph and result icons share it, so they line up. -->
    <x:Double x:Key="LeadingColumnWidth">56</x:Double>

    <Thickness x:Key="LauncherContentPadding">8,0,12,0</Thickness>
    <Thickness x:Key="ResultsPadding">8,6,8,8</Thickness>
    <Thickness x:Key="RowPadding">0,0,12,0</Thickness>

    <!-- Lines the empty-state message up with the titles in a populated list. -->
    <Thickness x:Key="EmptyStateTextMargin">48,0,0,0</Thickness>

    <!--
        DWM paints the window's outer border itself, following the rounded corners exactly,
        so the panel draws no stroke of its own. These live outside the ThemeDictionaries
        because code reads them directly, and theme-scoped keys only resolve against an
        element, not against Application.Current.Resources.
    -->
    <Color x:Key="WindowBorderColorDark">#3AFFFFFF</Color>
    <Color x:Key="WindowBorderColorLight">#30000000</Color>

    <!-- Matches the Windows 11 large window radius that DWMWCP_ROUND applies. -->
    <CornerRadius x:Key="LauncherCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="IconPlateCornerRadius">8</CornerRadius>

    <!-- ==== Type ramp ===================================================
         Segoe UI Variable Display is the Windows 11 display face; the Text
         optical size is the one tuned for small sizes, so rows use it.
    -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <x:Double x:Key="QueryFontSize">21</x:Double>
    <x:Double x:Key="ResultTitleFontSize">14</x:Double>
    <x:Double x:Key="ResultSubtitleFontSize">12</x:Double>
    <x:Double x:Key="KindHintFontSize">11</x:Double>
    <x:Double x:Key="SearchGlyphFontSize">19</x:Double>
    <x:Double x:Key="ResultGlyphFontSize">17</x:Double>

    <!-- ==== Motion ======================================================
         Entrance only. Animating dismissal would put latency between the
         keystroke and the launcher getting out of the way.
    -->
    <x:Double x:Key="EntranceOffsetY">-10</x:Double>

</ResourceDictionary>
